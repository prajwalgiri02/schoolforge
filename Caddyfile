# HTTPS for Studio and for every published school's domain. Certificates for
# schools are requested on their first visit, only for domains Studio confirms
# belong to a published school (/hosting/certificate-check).
{
	on_demand_tls {
		ask http://web:8080/hosting/certificate-check
	}
}

{$STUDIO_HOST} {
	reverse_proxy web:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy web:8080
}

http:// {
	redir https://{host}{uri} permanent
}
