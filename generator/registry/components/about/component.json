{
    "name": "about",
    "label": "About",
    "description": "School introduction with image, story and core values. Set mode to full for the About page.",
    "category": "section",
    "variants": [
        "split",
        "split-reverse",
        "stacked"
    ],
    "requires": [
        "school.about"
    ],
    "props": [
        {
            "name": "mode",
            "type": "select",
            "label": "Show",
            "options": [
                {
                    "value": "summary",
                    "label": "Short summary"
                },
                {
                    "value": "full",
                    "label": "Full story"
                }
            ]
        },
        {
            "name": "link",
            "type": "link",
            "label": "Read more button",
            "hideable": true,
            "help": "A button under the section. Leave empty for the automatic one."
        },
        {
            "name": "image",
            "type": "image",
            "label": "Photo"
        }
    ],
    "files": [
        "index.tsx"
    ]
}
