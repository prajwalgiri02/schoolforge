# Optional: POST contact form submissions as JSON to this URL (Zapier, Make, Slack webhook, your CRM...).
CONTACT_WEBHOOK_URL=

# Optional: POST admission/job applications, alumni registrations and testimonials
# (multipart/form-data, with uploaded files) to this URL.
FORMS_WEBHOOK_URL=

# Optional: load content from SchoolForge Studio (Publish tab → Headless content API)
# instead of the files generated with the site. Publishing in Studio refreshes it.
SCHOOLFORGE_CONTENT_URL=
SCHOOLFORGE_CONTENT_TOKEN=
# Seconds before content is re-checked even without a publish (default 3600).
SCHOOLFORGE_REVALIDATE=
