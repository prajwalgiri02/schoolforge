{
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["dom", "dom.iterable", "esnext"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "resolveJsonModule": true,
        "types": ["vite/client"],
        "paths": {
            "@/*": ["./resources/js/*"],
            "@admin/*": ["./generator/targets/laravel-inertia-react/files/resources/js/admin/*"],
            "@registry/*": ["./generator/registry/*"]
        }
    },
    "include": ["resources/js/**/*.ts", "resources/js/**/*.tsx", "generator/registry/**/*.ts", "generator/registry/**/*.tsx"]
}
